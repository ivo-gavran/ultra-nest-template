{
  "name": "ultra-nest-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "hooks:install": "lefthook install",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:cov": "vitest run --config vitest.coverage.config.ts --coverage",
    "verify:build": "node --enable-source-maps scripts/verify-build.js",
    "test:watch": "vitest --watch",
    "build:test:manual": "tsc -p tsconfig.manual.json",
    "setup:project": "node scripts/setup-project.ts",
    "verify:template": "node scripts/verify-template.ts"
  },
  "dependencies": {
    "@nestjs/authentication": "0.1.1",
    "@nestjs/authorization": "0.1.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/drizzle": "0.0.2",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.76.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@sentry/nestjs": "11.7.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@testcontainers/postgresql": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.4",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "lefthook": "2.2.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
