# Local development only. Never use these example credentials in production.
NODE_ENV=development
PORT=3000
# Required by the API pool and migration CLI. Set this to your local PostgreSQL database.
DATABASE_URL=postgresql://app:local-development-only@localhost:5432/app
# Optional: true or false. Defaults to true in development/test, false in production.
# Enables both /docs (UI) and /docs-json (OpenAPI).
# SWAGGER_ENABLED=true

# Local Compose only. Use URL-safe characters; production uses external secrets.
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=local-development-only
# Published API port on 127.0.0.1; container always listens on port 3000.
API_PORT=3000

# Required: generate 32 random bytes as hex in your untracked .env.
# docs/authentication.md supplies a command that writes the key without printing it.
# There is deliberately no default signing secret.
AUTH_SIGNING_KEY=
# Exact comma-separated origins, no paths/wildcards. Production requires HTTPS.
AUTH_TRUSTED_ORIGINS=https://localhost:3000

# Rate limiting (see docs/security.md). Defaults shown; in-memory, per-process.
# All budgets are per client IP per handler; clients behind one IP share them.
# RATE_LIMIT_GLOBAL_LIMIT=100
# RATE_LIMIT_GLOBAL_TTL_MS=60000
# RATE_LIMIT_AUTH_LIMIT=5
# RATE_LIMIT_AUTH_TTL_MS=60000
# RATE_LIMIT_AUTH_BLOCK_MS=300000
# RATE_LIMIT_ACCOUNT_LIMIT=3
# RATE_LIMIT_ACCOUNT_TTL_MS=60000
# Reverse proxies: false (default, ignore forwarding headers), a hop count
# (1-10), or comma-separated IPs/CIDRs/presets (loopback, linklocal,
# uniquelocal). Never use blanket trust; set only behind a known proxy.
# TRUST_PROXY=false
# Max JSON / URL-encoded request body in bytes (1024-1048576).
# REQUEST_BODY_LIMIT_BYTES=16384

# Observability (see docs/observability.md). Disabled unless configured; no
# collector or Sentry project is required. Never commit real DSNs or headers.
# Service name for logs, traces and metrics.
# OTEL_SERVICE_NAME=ultra-nest-template
# Sentry error reporting is enabled exactly when a DSN is set (HTTPS in production).
# SENTRY_DSN=
# OpenTelemetry traces/metrics over OTLP/HTTP to <endpoint>/v1/traces and /v1/metrics.
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Collector credentials as key=value pairs (percent-encode values); never in the URL.
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_TIMEOUT=5000
# Trace sampling ratio 0-1; inbound traceparent cannot raise it.
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_METRIC_EXPORT_INTERVAL=60000
